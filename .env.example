# Ports (bound to 127.0.0.1)
WORDPRESS_PORT=8080
ADMINER_PORT=8081

# Host user: containers write files as this user (check with `id -u` / `id -g`)
HOST_UID=1000
HOST_GID=1000

# Database Configuration
DB_HOST=db
DB_NAME=exampledb
DB_USER=exampleuser
DB_PASSWORD=examplepass
DB_ROOT_PASSWORD_RANDOM=1

# WordPress auto-install (first run only)
WP_URL=http://localhost:8080
WP_TITLE="WordPress Dev"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# Folders Names
PLUGIN_FOLDER_NAME=custom-core-plugin
THEME_FOLDER_NAME=custom-theme
